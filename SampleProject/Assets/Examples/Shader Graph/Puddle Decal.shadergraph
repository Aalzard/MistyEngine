    {
      "id": 13,
      "type": "CustomFunction",
      "function": "Ripple",
      "source": "Inline",
      "body": "let p = UV - vec2<f32>(0.5);\nlet d = max(length(p), 1e-3);\nlet w = sin(d * 70.0 - T * 5.0) * 0.18 * saturate(1.0 - d * 2.4);\nN = normalize(vec3<f32>(p / d * w, 1.0));",
      "inputs": [
        {
          "name": "UV",
          "ty": "Vec2"
        },
        {
          "name": "T",
          "ty": "Float"
        }
      ],
      "outputs": [
        {
          "name": "N",
          "ty": "Vec3"
        }
      ],
      "position": [
        -560.0,
        440.0
      ]
    },
